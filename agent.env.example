# Copy to ~/.config/yogapp/agent.env and fill in. chmod 600.
# This file is read by yogapp-ds-router (and optional helper scripts).
# NEVER commit the real file — only this example is tracked.

# Required. Get one at https://platform.deepseek.com (top up billing first).
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional. Enables models starting with "kimi" routed to Moonshot.
MOONSHOT_API_KEY=

# Optional. Local LM Studio server for models prefixed "local/".
LMSTUDIO_API_KEY=lm-studio

# Optional: disable desktop notifications on model drift/escalation.
YOGAPP_DS_NOTIFY=0
